<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/subtitle"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />
    <com.alma.mvp.Alma3DView
        android:id="@+id/almaImage"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:contentDescription="ALMA 3D" />

    <androidx.camera.view.PreviewView
        android:id="@+id/liveVisionPreview"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:visibility="gone" />
    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/chatText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ALMA: Hola. Soy ALMA. ¿En qué te acompaño?"
            android:textSize="17sp"
            android:lineSpacingExtra="6dp" />
    </ScrollView>

    <EditText
        android:id="@+id/messageInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/message_hint"
        android:maxLines="4" />

    <Button
        android:id="@+id/voiceButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HABLAR" />
<Button
    android:id="@+id/cameraButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="CÁMARA" />
<Button
    android:id="@+id/liveVisionButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="MIRAR" />
<Button
    android:id="@+id/fileButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="ARCHIVO" />
    <Button
        android:id="@+id/sendButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/send" />
</LinearLayout>
